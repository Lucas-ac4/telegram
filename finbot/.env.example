# Copiá este archivo como .env y completá los valores.

# Token que te dio @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABC-tu-token

# Tu API key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# IDs de Telegram que pueden usar el bot, separados por coma.
# Mandale /start al bot y te dice tu ID. Si lo dejás vacío, cualquiera puede usarlo (y gastar tus créditos).
ALLOWED_USER_IDS=

# Modelo de Claude. claude-opus-5-5 es el más capaz; claude-haiku-5-5 es ~40 veces más barato
# y para extraer gastos suele alcanzar.
CLAUDE_MODEL=claude-opus-5-5

# (Opcional) Notas de voz: API key de ElevenLabs para transcribir audio.
ELEVENLABS_API_KEY=

# Archivo de la base SQLite
DB_PATH=finbot.db

# Zona horaria para "hoy", "este mes", etc.
TIMEZONE=America/Argentina/Buenos_Aires
